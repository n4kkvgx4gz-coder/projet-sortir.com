{% extends 'base.html.twig' %}

{% block title %}
    Liste des sorties
{% endblock %}

{% block body %}

    <section class="activities-section">

        <div class="section-header">
            <h1>🎯 Toutes les sorties</h1>

            <a href="{{ path('sortie_create') }}"
               class="btn-create">
                + Créer une sortie
            </a>
        </div>

        <div class="activities-grid">

            {% for sortie in sorties %}

                <article class="card activity-card">

                    {% if sortie.urlPhoto %}
                        <img
                            src="{{ asset('images/' ~ sortie.urlPhoto) }}"
                            alt="{{ sortie.nom }}"
                        >
                    {% endif %}

                    <span class="badge">
                    {{ sortie.lieu.nomLieu }}
                </span>

                    <h2>{{ sortie.nom }}</h2>

                    <p>
                        {{ sortie.description }}
                    </p>

                    <p class="date">
                        📅 {{ sortie.dateDebut|date('d/m/Y H:i') }}
                    </p>

                </article>

            {% else %}

                <p>
                    Aucune sortie disponible.
                </p>

            {% endfor %}

        </div>

    </section>

{% endblock %}
