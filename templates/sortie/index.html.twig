{% extends 'base.html.twig' %}

{% block title %}
    Liste des sorties
{% endblock %}

{% block body %}

    <section class="activities-section">

        <div class="section-header">
            <h1>Toutes les sorties</h1>

            <a href="{{ path('sortie_create') }}"
               class="btn-create">
                + Créer une sortie
            </a>
        </div>

        <form method="get" class="filters-card">

            <input
                type="text"
                name="q"
                placeholder="Rechercher une sortie, une ville, un lieu..."
                value="{{ q|default('') }}"
            >

            <input
                type="date"
                name="dateMin"
                value="{{ dateMin|default('') }}"
            >

            <input
                type="date"
                name="dateMax"
                value="{{ dateMax|default('') }}"
            >

            <select name="departement">
                <option value="">Tous les campus</option>
                <option value="29" {{ departement == '29' ? 'selected' : '' }}>Quimper / Finistère</option>
                <option value="44" {{ departement == '44' ? 'selected' : '' }}>Nantes / Loire-Atlantique</option>
                <option value="35" {{ departement == '35' ? 'selected' : '' }}>Rennes / Ille-et-Vilaine</option>
                <option value="79" {{ departement == '79' ? 'selected' : '' }}>Niort / Deux-Sèvres</option>
            </select>

            <button class="btn-primary">
                Filtrer
            </button>

        </form>

        <br>

        <div class="activities-grid">

            {% for sortie in sorties %}

                <article class="activity-card">

                    <div class="card-image">
                        {% if sortie.urlPhoto %}
                            <img
                                src="{{ asset('images/' ~ sortie.urlPhoto) }}"
                                alt="{{ sortie.nom }}"
                            >
                        {% else %}
                            <img
                                src="{{ asset('images/default.jpg') }}"
                                alt="image par défaut"
                            >
                        {% endif %}

                        <span class="badge">
            {{ sortie.lieu.nomLieu }}
        </span>
                    </div>

                    <div class="card-content">

                        <h2>{{ sortie.nom }}</h2>

                        <p class="description">
                            {{ sortie.description|length > 90 ? sortie.description|slice(0, 90) ~ '...' : sortie.description }}
                        </p>

                        <div class="card-meta">
                            <span>📅 {{ sortie.dateDebut|date('d/m/Y H:i') }}</span>
                        </div>

                        <a href="{{ path('sortie_inscription', {'id': sortie.id}) }}"
                           class="btn-detail">
                            Voir détail
                        </a>

                    </div>

                </article>

            {% else %}

                <p>
                    Aucune sortie disponible.
                </p>

            {% endfor %}

        </div>

    </section>

{% endblock %}
