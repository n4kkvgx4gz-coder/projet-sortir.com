{% extends 'base.html.twig' %}

{% block title %}
    Créer une sortie
{% endblock %}

{% block body %}

    <div class="page">

        <div class="card form-card">

            <h1>Créer une sortie</h1>

            {{ form_start(sortieForm) }}

            {{ form_row(sortieForm.nom) }}

            {{ form_row(sortieForm.dateDebut) }}

            {{ form_row(sortieForm.dateCloture) }}

            {{ form_row(sortieForm.nbInscriptionsMax) }}

            {{ form_row(sortieForm.description) }}

            {{ form_row(sortieForm.categorie) }}

            {{ form_row(sortieForm.campus) }}

            <div class="form-group">

                <label>
                    Lieu
                </label>

                <div class="lieu-row">

                    <div class="lieu-select">
                        {{ form_widget(sortieForm.lieu) }}
                    </div>

                    <button
                        type="button"
                        id="openLieuModal"
                        class="btn-add-lieu"
                    >
                        +
                    </button>

                </div>

                <small class="form-help">
                    Recherchez un lieu existant ou ajoutez-en un nouveau.
                </small>

            </div>

            {{ form_row(sortieForm.image) }}

            <button class="btn-primary">
                Enregistrer
            </button>

            {{ form_end(sortieForm) }}

        </div>

    </div>

    {# =========================
       POPUP AJOUT LIEU
    ========================= #}

    <div id="lieuModal" class="custom-modal hidden">

        <div class="custom-modal-content">

            <h2>
                Ajouter un lieu
            </h2>

            <input
                type="text"
                id="nomLieu"
                placeholder="Ex : Bowling Master Quimper"
            >

            <input
                type="text"
                id="rueLieu"
                placeholder="Adresse"
            >

            <select id="villeSelect">

                {% for ville in villes %}

                    <option value="{{ ville.id }}">
                        {{ ville.nomVille }} - {{ ville.codePostal }}
                    </option>

                {% endfor %}

            </select>

            <button
                type="button"
                id="openVilleModal"
                class="btn-user"
            >
                + Ajouter une ville
            </button>

            <div class="modal-actions">

                <button
                    type="button"
                    id="saveLieu"
                    class="btn-primary"
                >
                    Enregistrer le lieu
                </button>

                <button
                    type="button"
                    id="closeLieuModal"
                    class="btn-danger"
                >
                    Fermer
                </button>

            </div>

        </div>

    </div>

    {# =========================
       POPUP AJOUT VILLE
    ========================= #}

    <div id="villeModal" class="custom-modal hidden">

        <div class="custom-modal-content">

            <h2>
                Ajouter une ville
            </h2>

            <input
                type="text"
                id="nomVille"
                placeholder="Ville"
            >

            <input
                type="text"
                id="codePostal"
                placeholder="Code postal"
            >

            <div class="modal-actions">

                <button
                    type="button"
                    id="saveVille"
                    class="btn-primary"
                >
                    Ajouter la ville
                </button>

                <button
                    type="button"
                    id="closeVilleModal"
                    class="btn-danger"
                >
                    Fermer
                </button>

            </div>

        </div>

    </div>

{% endblock %}

turbo:load
