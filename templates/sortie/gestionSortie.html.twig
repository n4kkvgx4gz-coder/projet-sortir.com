{% extends 'base.html.twig' %}
{% block title %}Gestion des sorties · Sortir.com{% endblock %}
{% block body %}
<main class="admin-users-page">
  <div class="admin-users-heading">
    <div><p class="admin-eyebrow">Administration</p><h1>Gestion des sorties</h1><p class="admin-users-intro">Consultez les sorties programmées, passées et annulées.</p></div>
    <a href="{{ path('sortie_create') }}" class="btn-primary">+ Créer une sortie</a>
  </div>
  <section class="admin-users-panel" aria-labelledby="admin-sorties-title">
    <div class="admin-users-panel-heading"><h2 id="admin-sorties-title">Liste des sorties</h2><p>{{ sorties|length }} sortie{{ sorties|length > 1 ? 's' : '' }}</p></div>
    <div class="admin-users-table-scroll"><table class="admin-users-table">
      <thead><tr><th scope="col">Sortie</th><th scope="col">Date</th><th scope="col">Organisateur</th><th scope="col">Lieu</th><th scope="col">Inscriptions max.</th><th scope="col">Statut</th><th scope="col">Action</th></tr></thead>
      <tbody>
      {% for sortie in sorties %}
        <tr>
          <td><strong>{{ sortie.nom }}</strong><span class="admin-secondary">{{ sortie.categorie ? sortie.categorie.nom : 'Sans catégorie' }}</span></td>
          <td>{{ sortie.dateDebut|date('d/m/Y à H:i') }}<span class="admin-secondary">Clôture : {{ sortie.dateCloture|date('d/m/Y') }}</span></td>
          <td>{{ sortie.organisateur ? sortie.organisateur.pseudo : 'Non renseigné' }}</td>
          <td>{{ sortie.lieu ? sortie.lieu.nomLieu : 'Non renseigné' }}</td>
          <td>{{ sortie.nbInscriptionsMax }}</td>
          <td>
            {% if sortie.motifAnnulation %}<span class="admin-status is-inactive">Annulée</span><span class="admin-secondary">{{ sortie.motifAnnulation }}</span>
            {% elseif not sortie.etat %}<span class="admin-status is-inactive">Inactive</span>
            {% elseif sortie.dateDebut < date() %}<span class="admin-status">Passée</span>
            {% else %}<span class="admin-status is-active">Programmée</span>{% endif %}
          </td>
          <td><a class="admin-action-link" href="{{ path('sortie_detail', {'id': sortie.id}) }}">Voir le détail</a></td>
        </tr>
      {% else %}<tr><td colspan="7" class="admin-empty">Aucune sortie enregistrée.</td></tr>{% endfor %}
      </tbody>
    </table></div>
  </section>
</main>
{% endblock %}
