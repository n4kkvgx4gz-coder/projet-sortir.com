{% extends 'base.html.twig' %}

{% block title %}Détail sortie{% endblock %}

{% block body %}

    <div class="activity-card">

        <div class="card-image">
            {% if sortie.urlPhoto %}
                <img src="{{ asset('images/' ~ sortie.urlPhoto) }}" alt="{{ sortie.nom }}">
            {% else %}
                <img src="{{ asset('images/default.jpg') }}" alt="image par défaut">
            {% endif %}

            <span class="badge">
                {{ sortie.lieu.nomLieu }}
            </span>
        </div>

        <div class="sortie-content">

            <h1>{{ sortie.nom }}</h1>

            <p>
                Du {{ sortie.dateDebut|date('d/m/Y H:i') }}
            </p>

            <p>
                Organisateur :
                {% if sortie.organisateur %}
                    <a href="{{ path('profil_detail', {'id': sortie.organisateur.id}) }}">
                        {{ sortie.organisateur.prenom }} {{ sortie.organisateur.nom }}
                    </a>
                {% else %}
                    <span>Organisateur inconnu</span>
                {% endif %}
            </p>

            <div class="infos-sortie">
                <p><strong>Date :</strong> {{ sortie.dateDebut|date('d/m/Y') }}</p>
                <p><strong>Heure :</strong> {{ sortie.dateDebut|date('H:i') }}</p>
                <p>
                    <strong>Places restantes :</strong>
                    {{ sortie.nbInscriptionsMax - sortie.inscriptions|length }}
                </p>
                <p><strong>Clôture :</strong> {{ sortie.dateCloture|date('d/m/Y') }}</p>
            </div>

            <div class="participants-section">

                <h2>
                    Participants inscrits ({{ sortie.inscriptions|length }})
                </h2>

                {% if sortie.inscriptions|length > 0 %}

                    <ul class="participants-list">

                        {% for inscription in sortie.inscriptions %}

                            {% if inscription.participant %}
                                <li class="participant-item">
                                    <a href="{{ path('profil_detail', {'id': inscription.participant.id}) }}">
                                        {{ inscription.participant.prenom }}
                                        {{ inscription.participant.nom }}
                                    </a>
                                </li>
                            {% endif %}

                        {% endfor %}

                    </ul>

                {% else %}

                    <p>Aucun participant inscrit pour le moment.</p>

                {% endif %}

            </div>

            <div class="actions-sortie">

                {% if sortie.etat and sortie.dateCloture > date() %}

                    {% if dejaInscrit %}
                        <form method="post" action="{{ path('sortie_desistement', {'id': sortie.id}) }}">
                            <button type="submit" class="btn-primary">
                                Se désister
                            </button>
                        </form>
                    {% else %}
                        <form method="post" action="{{ path('sortie_inscription', {'id': sortie.id}) }}">
                            <button type="submit" class="btn-primary">
                                S'inscrire
                            </button>
                        </form>
                    {% endif %}

                {% else %}
                    <p>Cette sortie est fermée.</p>
                {% endif %}

            </div>

            <div class="description">
                <h2>À propos</h2>
                <p>{{ sortie.description }}</p>
            </div>

        </div>
    </div>

{% endblock %}
