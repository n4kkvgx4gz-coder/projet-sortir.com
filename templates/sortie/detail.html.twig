{% extends 'base.html.twig' %}

{% block title %}Détail sortie{% endblock %}

{% block body %}

    <div class="activity-card">

        <div class="card-image">
            {% if sortie.urlPhoto %}
                <img
                    src="{{ asset('images/' ~ sortie.urlPhoto) }}"
                    alt="{{ sortie.nom }}"
                >
            {% else %}
                <img src="{{ asset('images/default.jpg') }}" alt="image par défaut">
            {% endif %}

            <span class="badge">
                {{ sortie.lieu.nomLieu }}
            </span>
        </div>

        <div class="sortie-content">

            <h1>{{ sortie.nom }}</h1>

            <p>
                Du {{ sortie.dateDebut|date('d/m/Y H:i') }}
            </p>

                {# petite modif pour eviter les erreirs d'id "organisateur" lorsqu'on supprime un utilisateur dans la BDD #}
            <p>
                Organisateur :

                {% if organisateur %}
                    <a href="{{ path('profil_voir', {'id': organisateur.id}) }}">
                        {{ organisateur.prenom }} {{ organisateur.nom }}
                    </a>
                {% else %}
                    <span>Organisateur inconnu</span>
                {% endif %}
            </p>

            <div class="infos-sortie">
                <p><strong>Date :</strong> {{ sortie.dateDebut|date('d/m/Y') }}</p>
                <p><strong>Heure :</strong> {{ sortie.dateDebut|date('H:i') }}</p>
                <p>
                    <strong>Places restantes :</strong>
                    {{ sortie.nbInscriptionsMax - sortie.inscriptions|length }}
                </p>
                <p><strong>Clôture :</strong> {{ sortie.dateCloture|date('d/m/Y') }}</p>
            </div>

            <div class="participants-section">

                <h2>
                    Participants inscrits ({{ sortie.inscriptions|length }})
                </h2>

                {% if sortie.inscriptions|length > 0 %}

                    <ul class="participants-list">

                        {% for inscription in sortie.inscriptions %}
                            {% set participant = inscription.participant %}

                            {% if participant is not null %}
                                <li class="participant-item">
                                    <a href="{{ path('profil_voir', {'id': participant.id}) }}">
                                        {{ participant.prenom }} {{ participant.nom }}
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}

                    </ul>

                {% else %}

                    <p>Aucun participant inscrit pour le moment.</p>

                {% endif %}

            </div>

            <div class="actions-sortie">

                {% if sortie.etat == 0 %}

                    <p>Cette sortie est annulée.</p>

                    {% if sortie.motifAnnulation %}
                        <p><strong>Motif :</strong> {{ sortie.motifAnnulation }}</p>
                    {% endif %}

                {% else %}

                    {% if app.user
                        and sortie.organisateur
                        and app.user.id == sortie.organisateur.id
                    %}

                        <form method="post" action="{{ path('sortie_annuler', {'id': sortie.id}) }}">
                            <input
                                type="text"
                                name="motif"
                                placeholder="Motif d’annulation"
                                required
                            >

                            <button type="submit" class="btn-danger">
                                Annuler la sortie
                            </button>
                        </form>

                    {% endif %}

                    {% if sortie.dateCloture > date() %}

                        {% if dejaInscrit %}
                            <form method="post" action="{{ path('sortie_desistement', {'id': sortie.id}) }}">
                                <button type="submit" class="btn-primary">
                                    Se désister
                                </button>
                            </form>
                        {% else %}
                            <form method="post" action="{{ path('sortie_inscription', {'id': sortie.id}) }}">
                                <button type="submit" class="btn-primary">
                                    S'inscrire
                                </button>
                            </form>
                        {% endif %}

                    {% else %}

                        <p>Clôture des inscriptions.</p>

                    {% endif %}

                {% endif %}

            </div>

            <div class="description">
                <h2>À propos</h2>
                <p>{{ sortie.description }}</p>
            </div>

        </div>
    </div>

{% endblock %}
