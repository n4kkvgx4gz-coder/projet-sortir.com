<header class="main-header">

    <div class="brand">
        <img
            class="header-logo"
            src="{{ asset('images/logo.png') }}"
            alt="Logo Sortir.com"
            width="50"
            height="50"
        >


        <a href="{{ path('app_main') }}" class="brand-title">
            Sortir.com
        </a>
    </div>

    <nav class="main-nav">
        <ul>

            <li>
                <a href="{{ path('app_main') }}">
                    Accueil
                </a>
            </li>

            <li>
                <a href="{{ path('app_sortie') }}">
                    Sorties
                </a>
            </li>
            <li>
                <a href="{{ path('profil_detail') }}">
                    Gérer profil
                </a>
            </li>

            <li>
                <a href="#">
                    Menu 2
                </a>
            </li>

            <li>
                <a href="#">
                    Menu 3
                </a>
            </li>

            {% if app.user %}

                <li>
                    <a href="{{ path('sortie_create') }}">
                        + Créer
                    </a>
                </li>

            {% endif %}

        </ul>
    </nav>

    <div class="user-actions">

        {% if app.user %}

            <span class="user-badge">
                👤 {{ app.user.userIdentifier }}
            </span>

            <a href="{{ path('app_logout') }}"
               class="btn-user logout">
                Déconnexion
            </a>

        {% else %}





        <a href="{{ path('app_login') }}"
               class="btn-user">
                Connexion
            </a>
            <a class="btn-user" href="{{ path("app_register") }}">Créer un compte</a>

        {% endif %}

    </div>

</header>
