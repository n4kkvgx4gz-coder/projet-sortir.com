{% extends 'base.html.twig' %}

{% block title %}Sorties{% endblock %}

{% block body %}
    <div class="page">
        <h1>Liste des sorties</h1>

        <p>Ta sortie a bien été créée.</p>

        <a href="{{ path('sortie_create') }}" class="btn-primary">
            Créer une nouvelle sortie
        </a>
    </div>

    <section class="page">
        <div class="page-title">
            <h1>Sorties à la une</h1>
            <p>Découvrez les prochaines activités proposées.</p>
        </div>

        <div class="grid">
            {% for sortie in sorties %}
                <article class="card activity-card">
                    {% if sortie.urlPhoto %}
                        <img src="{{ asset('images/' ~ sortie.urlPhoto) }}" alt="{{ sortie.nom }}">
                    {% endif %}

                    <span class="badge">
        {{ sortie.lieu.nomLieu }}
    </span>

                    <h2>{{ sortie.nom }}</h2>
                    <p>{{ sortie.description }}</p>

                    <p>📅 {{ sortie.dateDebut|date('d/m/Y H:i') }}</p>
                </article>
            {% else %}
                <p>Aucune sortie disponible pour le moment.</p>
            {% endfor %}
        </div>
    </section>
{% endblock %}
