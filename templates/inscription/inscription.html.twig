{% extends 'base.html.twig' %}

{% block title %}Inscription à une sortie{% endblock %}

{% block body %}

    <div class="page">

        <div class="card form-card">

            <h1>Inscription à une sortie</h1>

            <h2>{{ sortie.nom }}</h2>

            <p>
                <strong>Date de début :</strong>
                {{ sortie.dateDebut|date('d/m/Y H:i') }}
            </p>

            <p>
                <strong>Date limite :</strong>
                {{ sortie.dateCloture|date('d/m/Y H:i') }}
            </p>

            <p>
                <strong>Nombre maximal de places :</strong>
                {{ sortie.nbInscriptionsMax }}
            </p>

            <p>
                <strong>Description :</strong>
                {{ sortie.description }}
            </p>

            {% if sortie.etat %}

                <div class="button-container">
                    <form method="post"
                      action="{{ path('sortie_inscription', {'id': sortie.id}) }}">

                        <button type="submit" class="btn-primary">
                        S'inscrire
                         </button>

                     </form>

                    <form method="post" action="{{ path('sortie_desistement', {'id': sortie.id}) }}">

                        <button type="submit" class="btn-primary">
                        Se désister
                        </button>
                    </form>
                </div>

            {% else %}

                <p>
                    Cette sortie est fermée.
                </p>

            {% endif %}

        </div>

    </div>

{% endblock %}
