{% extends 'base.html.twig' %}

{% block title %}Détail de la sortie{% endblock %}

{% block body %}

    <div class="page-detail-sortie">

        <div class="detail-card">

            <div class="detail-image">
                <img src="{{ asset('images/sortie-default.jpg') }}" alt="Image de la sortie">
            </div>

            <div class="detail-content">

                <h1>{{ sortie.nom }}</h1>

                <p class="detail-subtitle">
                    Découvrez les informations de cette sortie
                </p>

                <div class="detail-info">
                    <p><strong>Date de début :</strong> {{ sortie.dateDebut|date('d/m/Y H:i') }}</p>
                    <p><strong>Date limite d'inscription :</strong> {{ sortie.dateCloture|date('d/m/Y H:i') }}</p>
                    <p><strong>Places disponibles :</strong> {{ sortie.nbInscriptionsMax }}</p>
                    <p><strong>Description :</strong> {{ sortie.description }}</p>
                </div>

                <div class="button-container">

                    {% if sortie.etat and sortie.dateCloture > date() %}

                        {% if dejaInscrit %}
                            <form method="post" action="{{ path('sortie_desistement', {'id': sortie.id}) }}">
                                <button type="submit" class="btn-primary">
                                    Se désister
                                </button>
                            </form>
                        {% else %}
                            <form method="post" action="{{ path('sortie_inscription', {'id': sortie.id}) }}">
                                <button type="submit" class="btn-primary">
                                    S'inscrire
                                </button>
                            </form>
                        {% endif %}

                    {% else %}
                        <p class="sortie-fermee">Cette sortie est fermée.</p>
                    {% endif %}

                </div>

            </div>

        </div>

    </div>

{% endblock %}
