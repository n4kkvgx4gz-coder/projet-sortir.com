{% extends 'base.html.twig' %}
{% block body %}

    <div class="card profil">
<h1> Mon profil </h1>
    <p> pseudo : {{ utilisateur.pseudo }}</p>
    <p> nom : {{ utilisateur.nom }}</p>
    <p> Prenom : {{ utilisateur.prenom }} </p>
    <p> tel : {{ utilisateur.telephone }}</p>
    <p> campus : {{ utilisateur.campus.getNomCampus() }}</p>


<a class="btn-user" href="{{ path('profil_modifier') }}">Modifier</a>
<a class="btn-user" href="{{ path('profil_supprimer') }}">Supprimer</a>
    </div>
{% endblock %}
