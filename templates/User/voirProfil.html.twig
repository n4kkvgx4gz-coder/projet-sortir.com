{% extends 'base.html.twig' %}
{% block body %}

    <div class="form-card" id="profil">


        <h1> Mon profil </h1>
        <p> pseudo : {{ utilisateur.pseudo }}</p>
        <p> nom : {{ utilisateur.nom }}</p>
        <p> Prenom : {{ utilisateur.prenom }} </p>
        <p> tel : {{ utilisateur.telephone }}</p>
        <p>campus : {{ utilisateur.campus }}</p>


                {% if utilisateur.urlPhoto is not null %}

                    <div id="profilImg">
                        <img
                            src="{{ asset('images/' ~ utilisateur.urlPhoto) }}"
                            alt="photo de profil"
                        >
                    </div>

                {% endif %}

                <div id="profilText">

                    <p>
                        pseudo : {{ utilisateur.pseudo }}
                    </p>

                    <p>
                        nom : {{ utilisateur.nom }}
                    </p>

                    <p>
                        prénom : {{ utilisateur.prenom }}
                    </p>

                    <p>
                        téléphone : {{ utilisateur.telephone }}
                    </p>

                    <p>
                        campus :
                        {{ utilisateur.campus
                        ? utilisateur.campus.nomCampus
                        : 'Non renseigné' }}
                    </p>

                </div>

            </div>

        {% else %}

            <p>
                Aucun utilisateur connecté.
            </p>

        {% endif %}

    </div>
{% endblock %}
