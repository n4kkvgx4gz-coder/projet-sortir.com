{% extends 'base.html.twig' %}

{% block title %}
    Gérer les utilisateurs
{% endblock %}

{% block body %}
    <h1>Gestion des utilisateurs</h1>
    <a href="#" class="btn-create">ajouter un utilisateur manuellement </a>
    <a href="#" class="btn-create"> ajouter une liste d'utilisateur via fichier </a>
    <h3> Liste des utilisateurs </h3>

<table>

        <tr>
            <th>Pseudo</th>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Email</th>
            <th>Rôle</th>
            <th>mot de passe</th>
            <th>téléphone</th>
            <th>campus</th>
            <th>url photo</th>
            <th>profil actif</th>
            <th>action</th>
        </tr>
    {% for user in utilisateurs %}

        <tr>
            <td>{{ user.pseudo }}</td>
            <td>{{ user.nom }}</td>
            <td>{{ user.prenom }}</td>
            <td>{{ user.email }}</td>
            <td>{{ user.roles|join(', ')}}</td>
            <td>{{ user.password }}</td>
            <td>{{ user.telephone }}</td>
            <td>{{ user.getCampus().getNomCampus() }}</td>
            <td>{{ user.getUrlPhoto }}</td>
            <td>{{ user.actif }}</td>
            <td>
                <a href="#" class="btn-create">supprimer</a>
                <a href="#" class="btn-create">modifier</a>
                <a href="#" class="btn-create">désactiver</a>
            </td>
        </tr>
    {% endfor %}
</table>

{% endblock %}
