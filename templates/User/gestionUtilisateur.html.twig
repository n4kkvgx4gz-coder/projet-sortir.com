{% extends 'base.html.twig' %}

{% block title %}
    Gérer les utilisateurs
{% endblock %}

{% block body %}
    <h1>Gestion des utilisateurs</h1>
    <a href="#">ajouter un utilisateur manuellement </a>
    <a href="#"> ajouter une liste d'utilisateur via fichier </a>
    <h3> Liste des utilisateurs </h3>

<table>

        <tr>
            <th>Pseudo</th>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Email</th>
            <th>Rôle</th>
            <th>mot de passe</th>
            <th>téléphone</th>
            <th>campus</th>
            <th>url photo</th>
            <th>profil actif</th>
            <th>action</th>
        </tr>
    {% for user in utilisateurs %}

        <tr>
            <td>{{ user.pseudo }}</td>
            <td>{{ user.nom }}</td>
            <td>{{ user.prenom }}</td>
            <td>{{ user.email }}</td>
            <td>{{ user.roles }}</td>
            <td>{{ user.password }}</td>
            <td>{{ user.telephone }}</td>
            <td>{{ user.campus.nom_campus }}</td>
            <td>{{ user.url_photo }}</td>
            <td>{{ user.actif }}</td>
            <td>
                <a>supprimer</a>
                <a>modifier</a>
            </td>
        </tr>
    {% endfor %}
</table>

{% endblock %}
